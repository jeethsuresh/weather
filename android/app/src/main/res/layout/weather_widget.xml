<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background" android:importantForAccessibility="yes" android:orientation="vertical" android:padding="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
        <TextView android:id="@+id/place" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Daybreak" android:textSize="11sp" android:textColor="#E4EEE5" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/advisory_pill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:paddingStart="5dp" android:paddingEnd="5dp" android:textSize="9sp" android:textColor="#172F29" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:visibility="gone" />
        <ImageView android:id="@+id/advisory_dot" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginStart="6dp" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="5dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:paddingEnd="3dp">
            <TextView android:id="@+id/daily_high" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="High 17°" android:gravity="center_vertical" android:textSize="14sp" android:textColor="#C7DAD0" android:includeFontPadding="false" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/temperature" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2" android:text="16°" android:gravity="center_vertical" android:textSize="36sp" android:textColor="#FFFFFF" android:fontFamily="sans-serif-light" android:includeFontPadding="false" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="40sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/daily_low" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="Low 5°" android:gravity="center_vertical" android:textSize="14sp" android:textColor="#AAC5B9" android:includeFontPadding="false" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:paddingStart="3dp">
            <ImageView android:id="@+id/weather_icon" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/widget_partly" android:scaleType="fitCenter" android:maxHeight="36dp" android:adjustViewBounds="true" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/temperature_graph" android:layout_width="match_parent" android:layout_height="28dp" android:layout_marginTop="3dp" android:src="@drawable/widget_graph_preview" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <TextView android:id="@+id/graph_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="2pm–2am" android:textSize="8sp" android:textColor="#AAC5B9" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/condition" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Partly cloudy" android:textSize="11sp" android:textColor="#E4EEE5" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="6dp" android:paddingBottom="5dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Wind" android:textSize="9sp" android:textColor="#AAC5B9" android:includeFontPadding="false" />
            <TextView android:id="@+id/wind" android:layout_width="match_parent" android:layout_height="17dp" android:text="12 km/h" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFF" android:includeFontPadding="false" android:gravity="center_vertical" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="4dp">
            <TextView android:id="@+id/precipitation_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Precip · 3pm" android:textSize="9sp" android:textColor="#AAC5B9" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/precipitation" android:layout_width="match_parent" android:layout_height="17dp" android:text="20%" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFF" android:includeFontPadding="false" android:gravity="center_vertical" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Updated now" android:textSize="9sp" android:textColor="#AAC5B9" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
